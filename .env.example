# HackerCode configuration. Copy to .env (never commit .env) or set these as environment variables.
# Every value below is a placeholder. Leave optional integrations empty and the UI will say they are not configured.

# --- Server -----------------------------------------------------------------
PORT=8080
# Public URL of the app. Used in email links and to decide whether dev-console email is allowed (localhost only).
APP_BASE_URL=http://localhost:8080
# Set to true when serving over HTTPS (marks session and remember-me cookies Secure).
COOKIE_SECURE=false
# Long random string that signs remember-me cookies. If empty, a random key is generated at each start.
HC_REMEMBER_ME_KEY=

# --- Database ---------------------------------------------------------------
# Default (leave these commented): an H2 file database in ./data for development.
# For production use PostgreSQL. docker-compose.yml sets the URL and user; it needs DATABASE_PASSWORD.
# Note: an empty value counts as "set", so keep unused lines commented out rather than blank.
# DATABASE_URL=jdbc:postgresql://localhost:5432/hackercode
# DATABASE_USER=hackercode
DATABASE_PASSWORD=change-me-to-a-long-random-password

# --- First administrator ----------------------------------------------------
# Sign up normally, set this to that email, restart once, then remove it. The promotion is audited.
HC_BOOTSTRAP_ADMIN_EMAIL=

# --- Email (verification, password reset, reminders) -------------------------
# Without SMTP, links are printed to the server console on localhost only; elsewhere no email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=HackerCode <no-reply@your-domain.example>

# --- Google sign-in (OAuth 2.0 / OpenID Connect) ------------------------------
# Create an OAuth client (Web application) in Google Cloud Console.
# Authorised redirect URI: {APP_BASE_URL}/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Code execution sandbox ---------------------------------------------------
# one of: none | docker | judge0 | piston
EXECUTION_PROVIDER=none
EXECUTION_TIMEOUT_SECONDS=5
EXECUTION_MEMORY_MB=256
# docker: path to the docker CLI (images listed in README must be pulled)
DOCKER_COMMAND=docker
# judge0: self-hosted Judge0 CE, or RapidAPI (set JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com)
JUDGE0_URL=
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_AUTH_TOKEN=
JUDGE0_RAPIDAPI_HOST=
# piston: self-hosted Piston base URL, e.g. http://localhost:2000
PISTON_URL=

# --- AI code review -----------------------------------------------------------
# one of: none | anthropic
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=60
